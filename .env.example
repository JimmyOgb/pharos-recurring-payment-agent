# Pharos Recurring Payment Agent — Environment Variables Reference
# All settings below are optional. The dApp defaults to public authoritative RPCs.

# Public RPC Endpoints (Optional Overrides)
VITE_PHAROS_PACIFIC_RPC="https://rpc.pharos.xyz"
VITE_PHAROS_ATLANTIC_RPC="https://atlantic.dplabs-internal.com"
VITE_BASE_MAINNET_RPC="https://mainnet.base.org"

# Default Network (Chain ID: 1672 = Pharos Pacific, 8453 = Base, 688689 = Pharos Atlantic)
VITE_DEFAULT_CHAIN_ID=1672
